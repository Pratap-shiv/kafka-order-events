          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"Rahul Verma\",\n  \"itemName\": \"Wireless Mouse\",\n  \"amount\": 899\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
